{
  "name": "argos-ai",
  "version": "0.1.16",
  "type": "module",
  "bin": {
    "argos": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/add-shebang.js",
    "dev": "tsc --watch",
    "prepublishOnly": "pnpm build",
