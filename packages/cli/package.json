  },
  "devDependencies": {
    "@argos/shared": "workspace:*",
    "@types/node": "^20",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "ip-address": "10.2.2",
    "typescript": "^5",
    "undici": "7.29.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=18"
  }
